# Normalize line endings: LF in repo, native on checkout for sources.
* text=auto eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
# Windows scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
# Binaries
*.png binary
*.ico binary
*.woff2 binary
