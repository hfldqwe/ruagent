# Rust
/target/
**/*.rs.bk
Cargo.lock.orig

# Node / panel
node_modules/
dist/
*.tsbuildinfo
panel/npm-debug.log*

# Environment & secrets — never commit
.env
.env.*
!.env.example

# Local daemon state (tests / dev runs)
/data/
*.db
*.db-wal
*.db-shm
*.lance/
/transcripts/
/workspaces/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp

# Local-only: vendored study materials (third-party content) and scratch
# logs — kept out of the public repo.
.agents/skills/
docs/design-study/
/*_stderr.log
/*_stdout.log

# AgentTeams runtime state (live team/task/mailbox state, not source)
/.agent-teams/

# Per-run screenshot artifacts (curated dirs like after/ before/ review/ stay tracked)
docs/screenshots/*-run*/
docs/screenshots/*-run/
docs/screenshots/audit-run*/
docs/screenshots/_misplaced-cwd/
docs/screenshots/t[0-9]*/
docs/screenshots/chat2/
docs/screenshots/light/

# Scratch probes (committed instruments live in panel/tools/)
panel/.*.py
panel/.*.mjs

# Member scratch dirs (instruments live in panel/tools/)
panel/.*/
